# Supabase analytics mirror (optional).
# The in-game leaderboard reads from the GenLayer contract, not from Supabase —
# leaving these unset only disables analytics mirroring.
# Enable Row Level Security on the project: the anon key is a public write
# credential and without RLS these tables accept arbitrary rows.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
